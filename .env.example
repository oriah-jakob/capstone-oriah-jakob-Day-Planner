# Copy to .env.local and fill in. Never commit a real .env file.
#
# Local values come from `npm run db:start`, which prints the API URL and keys.
# Hosted values come from the Supabase dashboard under Project Settings > API.

# Supabase project URL. Local default shown.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Publishable ("anon") key. Safe to expose in the browser: it only grants what
# the row level security policies allow. Never put the service role key here —
# anything prefixed VITE_ is compiled into the client bundle.
VITE_SUPABASE_ANON_KEY=

# Base URL the app is served from, used to build password reset links.
VITE_APP_URL=http://localhost:5173
